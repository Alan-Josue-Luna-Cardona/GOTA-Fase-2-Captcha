# Ejecución SIN Docker (XAMPP o PHP instalado en tu equipo).
# Copia este archivo como  GOTA-main/.env  (con punto al inicio) y ajusta
# usuario/contraseña a los de tu MySQL. En XAMPP el usuario es "root" y la
# contraseña viene vacía. Este archivo .env NO se sube a GitHub (.gitignore).
CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8080/'

database.default.hostname = 127.0.0.1
database.default.database = gota_db
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306
