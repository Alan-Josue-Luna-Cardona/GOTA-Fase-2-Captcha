# Copia este archivo como .env en esta misma carpeta y completa los valores.
# .env NUNCA se sube a GitHub (ver .gitignore).
#
# Con docker compose NO hace falta este archivo: las variables ya vienen
# definidas en docker-compose.yml. Solo se usa al ejecutar SIN Docker.

# Base de datos compartida con el monolito GOTA (misma base, mismas tablas
# Usuarios y Roles).
#   - Con Docker:  DB_HOST=db  (nombre del servicio en docker-compose)
#   - Sin Docker:  DB_HOST=127.0.0.1 (XAMPP: usuario root, contraseña vacía)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gota_db
DB_USER=root
DB_PASSWORD=

